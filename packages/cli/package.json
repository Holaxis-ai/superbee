{
  "name": "@superbee/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable process-oriented Superbee command runtime.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.mjs"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/run-test-command.mjs node --test --import ./test/ts-loader.mjs ./test/*.test.ts",
    "test:host-class": "node scripts/run-test-command.mjs node --test --import ./test/ts-loader.mjs ./test/private-state-bundle-boundary.test.ts ./test/filesystem-cross-process-cas.test.ts ./test/link.test.ts ./test/promote-pull.test.ts ./test/recipe-source.test.ts ./test/command-text.test.ts",
    "mutation": "node scripts/run-test-command.mjs npm-exec stryker run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@superbee/board-git": "*",
    "@superbee/bundle-descriptor": "*",
    "@superbee/core": "*",
    "@superbee/markdown-renderer": "*",
    "@superbee/mcp-app": "*",
    "@superbee/publication": "*",
    "@superbee/server": "*",
    "@superbee/ui-server": "*",
    "@toon-format/toon": "2.3.1",
    "@types/node": "^22.0.0",
    "axi-sdk-js": "0.1.8",
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "pako": "2.1.0",
    "typescript": "^5.5.0",
    "js-yaml": "3.15.2",
    "@types/js-yaml": "3.12.10"
  }
}
