{
  "name": "@superbee/integration-github",
  "version": "0.1.0-pre.1",
  "type": "module",
  "description": "GitHub repository issue source profile and Work Item recipes for Superbee.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Holaxis-ai/superbee.git",
    "directory": "packages/integration-github"
  },
  "main": "./dist/profile.mjs",
  "types": "./dist/profile.d.ts",
  "exports": {
    ".": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.mjs"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.mjs"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.mjs"
    }
  },
  "files": [
    "dist",
    "recipes",
    "fixtures",
    "PROFILE.md"
  ],
  "sideEffects": false,
  "superbeeIntegration": {
    "contract": 1,
    "id": "github",
    "core": "0.2.0-pre.22",
    "profiles": [
      {
        "id": "github-issues",
        "version": 1,
        "entry": "dist/profile.mjs"
      }
    ],
    "recipes": {
      "source-feeds": "recipes/source-feeds",
      "work-items": "recipes/work-items"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ../core/test/ts-loader.mjs test/*.test.ts",
    "prepublishOnly": "node -e \"console.error('@superbee/integration-github release and human bootstrap are not configured; do not run npm publish here'); process.exit(1)\""
  },
  "peerDependencies": {
    "@superbee/core": "0.2.0-pre.22"
  },
  "peerDependenciesMeta": {
    "@superbee/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@superbee/core": "0.2.0-pre.22",
    "typescript": "^5.4.0",
    "esbuild": "^0.25.0",
    "@types/node": "^22.0.0"
  }
}
