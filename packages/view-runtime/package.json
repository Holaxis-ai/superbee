{
  "name": "@superbee/view-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared launch and governed-action authority for AgentState human View hosts.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
