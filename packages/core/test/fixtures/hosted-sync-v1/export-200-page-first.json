{
  "name": "export-200-page-first",
  "description": "The first page of a paged export: a whole zip whose manifest's page names the next cursor.",
  "route": "/sync/v1/export",
  "rows": [
    "export 200 page"
  ],
  "request": {
    "method": "POST",
    "headers": {
      "content-type": "application/json"
    },
    "body": "{\"bundleId\":\"notes.a\",\"paged\":true}"
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/zip",
      "content-disposition": "attachment; filename=\"notes.a-2.zip\""
    },
    "bodyBase64": "",
    "truncated": false
  }
}
