{
  "name": "@superbee/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OKF store engine — bundle I/O, cross-links, derived backlinks, freshness, and versioned writes.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kinds": {
      "types": "./dist/kinds.d.ts",
      "default": "./dist/kinds.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./meaningful-change-time": {
      "types": "./dist/meaningful-change-time.d.ts",
      "default": "./dist/meaningful-change-time.js"
    },
    "./mutation-attribution": {
      "types": "./dist/mutation-attribution.d.ts",
      "default": "./dist/mutation-attribution.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./query-filter": {
      "types": "./dist/query-filter.d.ts",
      "default": "./dist/query-filter.js"
    },
    "./query-selection": {
      "types": "./dist/query-selection.d.ts",
      "default": "./dist/query-selection.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./test/ts-loader.mjs ./test/*.test.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0"
  },
  "devDependencies": {
    "@superbee/server": "*",
    "@types/js-yaml": "3.12.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
