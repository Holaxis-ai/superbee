{
  "name": "@superbee/core",
  "version": "0.2.0-pre.1",
  "type": "module",
  "description": "OKF store engine — bundle I/O, cross-links, derived backlinks, freshness, and versioned writes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Holaxis-ai/superbee.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/bundle.js"
  ],
  "exports": {
    "./view-admission": {
      "types": "./dist/view-admission.d.ts",
      "default": "./dist/view-admission.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundle-ops": {
      "types": "./dist/bundle-ops.d.ts",
      "default": "./dist/bundle-ops.js"
    },
    "./document-codec": {
      "types": "./dist/document-codec.d.ts",
      "default": "./dist/document-codec.js"
    },
    "./document-mutation": {
      "types": "./dist/document-mutation.d.ts",
      "default": "./dist/document-mutation.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.js"
    },
    "./kinds": {
      "types": "./dist/kinds.d.ts",
      "default": "./dist/kinds.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./meaningful-change-time": {
      "types": "./dist/meaningful-change-time.d.ts",
      "default": "./dist/meaningful-change-time.js"
    },
    "./mutation-attribution": {
      "types": "./dist/mutation-attribution.d.ts",
      "default": "./dist/mutation-attribution.js"
    },
    "./verification": {
      "types": "./dist/verification.d.ts",
      "default": "./dist/verification.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./publication-filesystem": {
      "types": "./dist/publication-filesystem.d.ts",
      "default": "./dist/publication-filesystem.js"
    },
    "./query-filter": {
      "types": "./dist/query-filter.d.ts",
      "default": "./dist/query-filter.js"
    },
    "./query-selection": {
      "types": "./dist/query-selection.d.ts",
      "default": "./dist/query-selection.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./remote-operations": {
      "types": "./dist/remote-operations.d.ts",
      "default": "./dist/remote-operations.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./versioning": {
      "types": "./dist/versioning.d.ts",
      "default": "./dist/versioning.js"
    },
    "./memory-backend": {
      "types": "./dist/memory-backend.d.ts",
      "default": "./dist/memory-backend.js"
    },
    "./indexeddb-backend": {
      "types": "./dist/indexeddb-backend.d.ts",
      "default": "./dist/indexeddb-backend.js"
    },
    "./uncertain-write": {
      "types": "./dist/uncertain-write.d.ts",
      "default": "./dist/uncertain-write.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./test/ts-loader.mjs ./test/*.test.ts",
    "mutation": "stryker run",
    "prepublishOnly": "node -e \"console.error('@superbee/core is released by .github/workflows/release-libraries.yml; do not run npm publish here'); process.exit(1)\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2"
  },
  "devDependencies": {
    "@superbee/server": "*",
    "@types/js-yaml": "3.12.10",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.4.0"
  }
}
