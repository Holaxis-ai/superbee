{
  "name": "@superbee/core",
  "version": "0.1.0",
  "type": "module",
  "description": "OKF store engine — bundle I/O, cross-links, derived backlinks, freshness, and versioned writes.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./kinds": {
      "types": "./dist/kinds.d.ts",
      "default": "./dist/kinds.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./meaningful-change-time": {
      "types": "./dist/meaningful-change-time.d.ts",
      "default": "./dist/meaningful-change-time.js"
    },
    "./mutation-attribution": {
      "types": "./dist/mutation-attribution.d.ts",
      "default": "./dist/mutation-attribution.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.js"
    },
    "./publication-filesystem": {
      "types": "./dist/publication-filesystem.d.ts",
      "default": "./dist/publication-filesystem.js"
    },
    "./query-filter": {
      "types": "./dist/query-filter.d.ts",
      "default": "./dist/query-filter.js"
    },
    "./query-selection": {
      "types": "./dist/query-selection.d.ts",
      "default": "./dist/query-selection.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./test/ts-loader.mjs ./test/*.test.ts",
    "mutation": "stryker run",
    "prepublishOnly": "node -e \"console.error('@superbee/core is released by .github/workflows/release-libraries.yml; do not run npm publish here'); process.exit(1)\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2"
  },
  "devDependencies": {
    "@superbee/server": "*",
    "@types/js-yaml": "3.12.10",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
