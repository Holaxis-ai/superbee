{
  "name": "@superbee/mcp-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP Apps adapter for rendered Superbee documents and conversational Views.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build -w @superbee/markdown-renderer -w @superbee/view-runtime",
    "build": "node scripts/build-view.mjs && tsc",
    "pretypecheck": "npm run build -w @superbee/markdown-renderer -w @superbee/view-runtime",
    "typecheck": "node scripts/build-view.mjs && tsc --noEmit",
    "pretest": "npm run build -w @superbee/markdown-renderer -w @superbee/view-runtime",
    "test": "node scripts/build-view.mjs && node --test --import ./test/ts-loader.mjs ./test/*.test.ts ./test/*.test.mjs",
    "test:browser": "playwright install chromium && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@superbee/core": "*",
    "@superbee/markdown-renderer": "*",
    "@superbee/view-runtime": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.0",
    "ajv": "^8.18.0",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3"
  }
}
