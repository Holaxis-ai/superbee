{
  "name": "@superbee/browser-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-local working copy of a Superbee bundle: the IndexedDB bundle path proven in real Chromium.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright install chromium && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@superbee/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
