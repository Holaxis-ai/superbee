{
  "schema": "superbee.ci-lanes.v1",
  "path_skipping": false,
  "source_preflight": "npm run check:package-versions",
  "node_policy": {
    "compatibility_floor": "22.14.0",
    "supported_majors": [
      22,
      24,
      26
    ],
    "engine_range": "^22.14.0 || ^24.0.0 || ^26.0.0",
    "build_target": "node22",
    "default_runtime": "24.21.0",
    "forward_probe": 26,
    "release_pin_owner": "process:release-preflight",
    "release_pin_reviewed_at": "2026-09-24",
    "release_pin_refresh_by": "2026-10-24",
    "forward_review": {
      "review_after": "2026-10-28",
      "disposition": "pending",
      "decided_at": null,
      "decided_by": null,
      "evidence": null,
      "revisit_by": null
    },
    "floor_retirement": {
      "retire_by": "2027-04-30"
    }
  },
  "runtime_nodes": [
    22,
    26
  ],
  "singleton_node": "24.21.0",
  "host_expectation_variable": "SUPERBEE_TEST_EXPECT_ALIASING_HOST",
  "merge_queue": {
    "enabled": false,
    "evidence": "No merge-queue workflow or repository-settings evidence exists at this revision",
    "enablement_requirement": "Set enabled true and add the merge_group trigger before enabling merge queue"
  },
  "security_analysis": {
    "workflow": ".github/workflows/codeql.yml",
    "config": ".github/codeql/codeql-config.yml",
    "triggers": [
      "pull_request",
      "push",
      "schedule",
      "workflow_dispatch"
    ],
    "schedule": "23 7 * * 1",
    "concurrency": {
      "group": "codeql-${{ github.event_name }}-${{ github.ref }}",
      "cancel_in_progress": "${{ github.event_name == 'pull_request' }}"
    },
    "permissions": {
      "actions": "read",
      "contents": "read",
      "security-events": "write"
    },
    "action_pins": {
      "checkout": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
      "codeql_init": "github/codeql-action/init@cdf488f595d80d6e07e03d4674febd5ab45fa938",
      "codeql_analyze": "github/codeql-action/analyze@cdf488f595d80d6e07e03d4674febd5ab45fa938"
    },
    "checkout_persist_credentials": false,
    "query_suite": "security-extended",
    "threat_model": "local",
    "paths": [
      "packages",
      "scripts"
    ],
    "paths_ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/test/**",
      "**/tests/**",
      "**/e2e/**",
      "**/fixtures/**",
      "**/*.test.*"
    ],
    "representative_includes": [
      "packages/board-git/src/porcelain.ts",
      "packages/cli/src/args.ts",
      "packages/core/src/publication-filesystem.ts",
      "packages/publication/src/generated/publication-snapshot-v1.ts",
      "scripts/verify-npm-package.mjs"
    ],
    "representative_excludes": [
      "packages/board-git/test/git-porcelain.test.ts",
      "packages/cli/test/fixtures/quoting-probes/probes.ts",
      "packages/ui/e2e/harness.ts",
      "scripts/verify-npm-package.test.mjs"
    ],
    "jobs": {
      "javascript-typescript": {
        "display_name": "CodeQL JavaScript/TypeScript",
        "language": "javascript-typescript",
        "build_mode": "none",
        "category": "/language:javascript-typescript",
        "timeout_minutes": 30
      },
      "github-actions": {
        "display_name": "CodeQL GitHub Actions",
        "language": "actions",
        "build_mode": "none",
        "category": "/language:actions",
        "timeout_minutes": 30
      },
      "required": {
        "display_name": "CodeQL required analyses",
        "needs": [
          "javascript-typescript",
          "github-actions"
        ],
        "timeout_minutes": 5
      }
    },
    "merge_enforcement": "human-owned GitHub ruleset after hosted evidence; workflow success proves analysis completion only"
  },
  "required_jobs": [
    "runtime",
    "aliasing-host",
    "smoke-node-22",
    "distribution",
    "browser",
    "scripts"
  ],
  "components": [
    {
      "id": "build",
      "command": "npm run build",
      "owner": "runtime"
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck",
      "owner": "runtime"
    },
    {
      "id": "workspace-tests",
      "command": "npm test --workspaces --if-present",
      "owner": "runtime"
    },
    {
      "id": "script-tests",
      "command": "npm run test:scripts",
      "owner": "scripts"
    },
    {
      "id": "installed-package-proof",
      "command": "npm run verify:npm-package",
      "owner": "distribution"
    },
    {
      "id": "skill-drift-proof",
      "command": "npm run check:skill -w superbee",
      "owner": "distribution"
    },
    {
      "id": "mcp-browser",
      "command": "npm run test:browser -w @superbee/mcp-app",
      "owner": "browser"
    },
    {
      "id": "ui-end-to-end",
      "command": "npm run e2e:gate -w @superbee/ui",
      "owner": "browser"
    },
    {
      "id": "browser-local-chromium",
      "command": "npm run test:browser -w @superbee/browser-local",
      "owner": "browser"
    }
  ],
  "lanes": {
    "runtime": {
      "display_name": "runtime compatibility (node ${{ matrix.node-version }})",
      "script": "ci:runtime",
      "components": [
        "build",
        "typecheck",
        "workspace-tests"
      ],
      "nodes": [
        22,
        26
      ],
      "runs_on": "ubuntu-latest",
      "expect_aliasing_host": "0",
      "host_guard": "mkdir -p \"$RUNNER_TEMP/host-probe\" && touch \"$RUNNER_TEMP/host-probe/probe-name\" && test ! -e \"$RUNNER_TEMP/host-probe/PROBE-NAME\""
    },
    "aliasing-host": {
      "display_name": "host-class proofs on an aliasing host (macos, node 24.21.0)",
      "script": "ci:aliasing-host",
      "components": [],
      "nodes": [
        "24.21.0"
      ],
      "runs_on": "macos-latest",
      "expect_aliasing_host": "1",
      "host_guard": "mkdir -p \"$RUNNER_TEMP/host-probe\" && touch \"$RUNNER_TEMP/host-probe/probe-name\" && test -e \"$RUNNER_TEMP/host-probe/PROBE-NAME\""
    },
    "distribution": {
      "display_name": "distribution package and installed behavior",
      "script": "ci:distribution",
      "components": [
        "installed-package-proof",
        "skill-drift-proof"
      ],
      "nodes": [
        "24.21.0"
      ]
    },
    "browser": {
      "display_name": "browser and UI",
      "script": "ci:browser",
      "components": [
        "mcp-browser",
        "ui-end-to-end",
        "browser-local-chromium"
      ],
      "prerequisites": [
        "build"
      ],
      "nodes": [
        "24.21.0"
      ]
    },
    "scripts": {
      "display_name": "repository scripts and CI topology",
      "script": "ci:scripts",
      "components": [
        "script-tests"
      ],
      "prerequisites": [
        "build"
      ],
      "nodes": [
        "24.21.0"
      ]
    },
    "smoke-node-22": {
      "display_name": "installed-package smoke on the engines floor (node 22.14.0)",
      "workflow_only": true,
      "components": [],
      "nodes": [
        "22.14.0"
      ],
      "build_runtime": "24.21.0",
      "runtime_setup_node": "22.14.0",
      "version_guard": "test \"$(node --version)\" = \"v22.14.0\"",
      "superbee_tarball": "out/node-floor/superbee.tgz",
      "cli_tarball": "out/node-floor/superbee-cli.tgz"
    }
  }
}
