{
  "schema": "superbee.ci-lanes.v1",
  "path_skipping": false,
  "runtime_nodes": [
    22,
    26
  ],
  "singleton_node": 26,
  "host_expectation_variable": "SUPERBEE_TEST_EXPECT_ALIASING_HOST",
  "merge_queue": {
    "enabled": false,
    "evidence": "No merge-queue workflow or repository-settings evidence exists at this revision",
    "enablement_requirement": "Set enabled true and add the merge_group trigger before enabling merge queue"
  },
  "security_analysis": {
    "workflow": ".github/workflows/codeql.yml",
    "config": ".github/codeql/codeql-config.yml",
    "triggers": [
      "pull_request",
      "push",
      "schedule",
      "workflow_dispatch"
    ],
    "schedule": "23 7 * * 1",
    "concurrency": {
      "group": "codeql-${{ github.event_name }}-${{ github.ref }}",
      "cancel_in_progress": "${{ github.event_name == 'pull_request' }}"
    },
    "permissions": {
      "actions": "read",
      "contents": "read",
      "security-events": "write"
    },
    "checkout_persist_credentials": false,
    "query_suite": "security-extended",
    "threat_model": "local",
    "paths": [
      "packages",
      "scripts"
    ],
    "paths_ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/test/**",
      "**/tests/**",
      "**/e2e/**",
      "**/fixtures/**",
      "**/*.test.*"
    ],
    "representative_includes": [
      "packages/board-git/src/porcelain.ts",
      "packages/cli/src/args.ts",
      "packages/core/src/publication-filesystem.ts",
      "packages/publication/src/generated/publication-snapshot-v1.ts",
      "scripts/verify-npm-package.mjs"
    ],
    "representative_excludes": [
      "packages/board-git/test/git-porcelain.test.ts",
      "packages/cli/test/fixtures/quoting-probes/probes.ts",
      "packages/ui/e2e/harness.ts",
      "scripts/verify-npm-package.test.mjs"
    ],
    "jobs": {
      "javascript-typescript": {
        "display_name": "CodeQL JavaScript/TypeScript",
        "language": "javascript-typescript",
        "build_mode": "none",
        "category": "/language:javascript-typescript",
        "timeout_minutes": 30
      },
      "github-actions": {
        "display_name": "CodeQL GitHub Actions",
        "language": "actions",
        "build_mode": "none",
        "category": "/language:actions",
        "timeout_minutes": 30
      },
      "required": {
        "display_name": "CodeQL required analyses",
        "needs": [
          "javascript-typescript",
          "github-actions"
        ],
        "timeout_minutes": 5
      }
    },
    "merge_enforcement": "human-owned GitHub ruleset after hosted evidence; workflow success proves analysis completion only"
  },
  "required_jobs": [
    "runtime",
    "aliasing-host",
    "smoke-node-20",
    "distribution",
    "browser",
    "scripts"
  ],
  "components": [
    {
      "id": "build",
      "command": "npm run build",
      "owner": "runtime"
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck",
      "owner": "runtime"
    },
    {
      "id": "workspace-tests",
      "command": "npm test --workspaces --if-present",
      "owner": "runtime"
    },
    {
      "id": "script-tests",
      "command": "npm run test:scripts",
      "owner": "scripts"
    },
    {
      "id": "installed-package-proof",
      "command": "npm run verify:npm-package",
      "owner": "distribution"
    },
    {
      "id": "skill-drift-proof",
      "command": "npm run check:skill -w superbee",
      "owner": "distribution"
    },
    {
      "id": "mcp-browser",
      "command": "npm run test:browser -w @superbee/mcp-app",
      "owner": "browser"
    },
    {
      "id": "ui-end-to-end",
      "command": "npm run e2e:gate -w @superbee/ui",
      "owner": "browser"
    }
  ],
  "lanes": {
    "runtime": {
      "display_name": "runtime compatibility (node ${{ matrix.node-version }})",
      "script": "ci:runtime",
      "components": [
        "build",
        "typecheck",
        "workspace-tests"
      ],
      "nodes": [
        22,
        26
      ],
      "runs_on": "ubuntu-latest",
      "expect_aliasing_host": "0",
      "host_guard": "mkdir -p \"$RUNNER_TEMP/host-probe\" && touch \"$RUNNER_TEMP/host-probe/probe-name\" && test ! -e \"$RUNNER_TEMP/host-probe/PROBE-NAME\""
    },
    "aliasing-host": {
      "display_name": "host-class proofs on an aliasing host (macos, node 26)",
      "script": "ci:aliasing-host",
      "components": [],
      "nodes": [
        26
      ],
      "runs_on": "macos-latest",
      "expect_aliasing_host": "1",
      "host_guard": "mkdir -p \"$RUNNER_TEMP/host-probe\" && touch \"$RUNNER_TEMP/host-probe/probe-name\" && test -e \"$RUNNER_TEMP/host-probe/PROBE-NAME\""
    },
    "windows": {
      "display_name": "native Windows runtime and installed package",
      "workflow_only": true,
      "required": false,
      "trigger": "workflow_dispatch",
      "workflow": ".github/workflows/windows-installed-package.yml",
      "components": [],
      "nodes": [
        22,
        20
      ],
      "runs_on": "windows-latest",
      "runtime_node": 22,
      "installed_package_node": 20,
      "installed_package_proof_script": "scripts/windows-installed-package-proof.mjs",
      "installed_package_proof_sha256": "e7044a178fb6d5fcc07cf2a2d523b27b65f6b9d4c9674a4af4f5cf28f9080151",
      "installed_package_proof_digest_update": {
        "command": "node scripts/windows-installed-package-proof-digest.mjs",
        "instructions": "After an intentional review of the proof bytes, run the command and update installed_package_proof_sha256 in this manifest in the same commit."
      },
      "installed_package_scenarios": {
        "catalog-lifecycle": [
          "catalog add",
          "catalog list",
          "catalog resolve"
        ],
        "local-remote-sync": [
          "sync --establish",
          "sync"
        ],
        "ui-url-lifecycle": [
          "ui --dir",
          "ui-url observed",
          "ui-url cleared"
        ],
        "managed-document-lifecycle": [
          "doc open",
          "parent exit",
          "authority reuse/isolation/convergence",
          "real Chrome render",
          "exact stop"
        ],
        "mcp-config-lifecycle": [
          "mcp install",
          "mcp status",
          "mcp config read-back",
          "mcp uninstall"
        ]
      },
      "built_cli_commands": [
        "init",
        "doc write",
        "doc read",
        "link add",
        "link show",
        "list",
        "status"
      ]
    },
    "distribution": {
      "display_name": "distribution package and installed behavior",
      "script": "ci:distribution",
      "components": [
        "installed-package-proof",
        "skill-drift-proof"
      ],
      "nodes": [
        26
      ]
    },
    "browser": {
      "display_name": "browser and UI",
      "script": "ci:browser",
      "components": [
        "mcp-browser",
        "ui-end-to-end"
      ],
      "prerequisites": [
        "build"
      ],
      "nodes": [
        26
      ]
    },
    "scripts": {
      "display_name": "repository scripts and CI topology",
      "script": "ci:scripts",
      "components": [
        "script-tests"
      ],
      "prerequisites": [
        "build"
      ],
      "nodes": [
        26
      ]
    },
    "smoke-node-20": {
      "display_name": "built-CLI smoke on the engines floor (node 20)",
      "workflow_only": true,
      "components": [],
      "nodes": [
        20
      ],
      "runtime_setup_node": 20,
      "version_guard": "node --version | grep -q '^v20\\.'",
      "built_cli": "packages/cli/dist/superbee.mjs",
      "built_cli_commands": [
        "init",
        "doc write",
        "doc read",
        "link add",
        "link show",
        "list",
        "status"
      ]
    }
  }
}
